/* This bundles and type checks the server files */
{
    "compilerOptions": {
        "target": "ES2020",
        "module": "Node16",
        "baseUrl": ".",
        "outDir": "../../dist/server",
        "rootDir": ".",
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "moduleResolution": "nodenext",
        "types": ["vitest"],
        "paths": {
            "@/*": ["*"]
        }
    },
    "include": ["**/*"],
    "exclude": ["node_modules", "dist", "**/*.test.ts", "**/__tests__/**/*"]
}
